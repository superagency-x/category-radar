# Category Radar Environment Variables
# Copy this file to .env and fill in values

# Optional: Custom user agent (default: CategoryRadar/1.0)
RADAR_USER_AGENT="CategoryRadar/1.0 (personal market-research project; contact: berksaraloglu@gmail.com)"

# Optional: Slack webhook for alerts (future feature)
SLACK_WEBHOOK_URL=""

# Optional: ECB API key (if required in future)
ECB_API_KEY=""

# Hosted application settings (required by category_radar.saas.app)
# Use a dedicated least-privilege application database role in production.
RADAR_DATABASE_URL="postgresql+psycopg://radar_app:change-me@db.example.com:5432/postgres?sslmode=require"
RADAR_SUPABASE_URL="https://your-project-ref.supabase.co"
